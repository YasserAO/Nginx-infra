# Core
COMPOSE_PROJECT_NAME=nginx-infra
NGINX_IMAGE=nginx:1.27-alpine
TZ=UTC

# Ports exposed on the host
HTTP_PORT=80
HTTPS_PORT=443

# Domain and proxy target
SERVER_NAME=*.vendra.cfd
UPSTREAM_HOST=app
UPSTREAM_PORT=80

# Nginx tuning
CLIENT_MAX_BODY_SIZE=20m
KEEPALIVE_TIMEOUT=65
ERROR_LOG_LEVEL=warn